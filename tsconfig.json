{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "public/pagefind",
    ".astropaper-trash",
    "infra",
    "jetpack",
    "libs",
    "prescriptions",
    "store",
    "wishlist",
    "wishlist1"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}

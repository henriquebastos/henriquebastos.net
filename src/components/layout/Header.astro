---
import { getLocaleConfig } from "@/data/locale";
import { siteConfig } from "@/site-config";
import type { SiteLanguage } from "@/types";
import { withBase } from "@/utils/path";
import ThemeToggle from "../ThemeToggle.astro";

interface Props {
	lang?: SiteLanguage;
}

const { lang = siteConfig.lang } = Astro.props;
const url = new URL(Astro.request.url);
const locale = getLocaleConfig(lang);
const wordmark = siteConfig.title;
const profile = siteConfig.profile;

const isActive = (path: string) => {
	const target = withBase(path);
	if (path === "/" || path === locale.homePath) return url.pathname === target;
	return url.pathname === target || url.pathname.startsWith(target);
};
---

<header class="site-header" id="main-header">
	<a href={withBase(locale.homePath)} class="wordmark">
		<svg class="logo" viewBox="0 0 500 400" aria-hidden="true">
			<rect x="0" y="50" width="100" height="300"></rect>
			<rect x="0" y="150" width="200" height="100"></rect>
			<rect x="200" y="0" width="100" height="400"></rect>
			<path d="M400,50 h50 a50,50 0 0 1 0,100 h-50 z"></path>
			<path d="M400,250 h50 a50,50 0 0 1 0,100 h-50 z"></path>
		</svg>
		<span>{wordmark}</span>
	</a>
	<div class="header-right">
		<nav class="nav" aria-label={locale.primaryNavigationLabel}>
			{
				locale.menuLinks.map((link) => (
					<a
						aria-current={isActive(link.path) ? "page" : false}
						class:list={[{ active: isActive(link.path) }]}
						data-astro-prefetch
						href={withBase(link.path)}
					>
						<span>{link.title}</span>
					</a>
				))
			}
		</nav>
		<div class="socials">
			{profile?.github && (
				<a href={profile.github} rel="noreferrer" target="_blank" aria-label="GitHub">
					<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
					</svg>
				</a>
			)}
			{profile?.linkedin && (
				<a href={profile.linkedin} rel="noreferrer" target="_blank" aria-label="LinkedIn">
					<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path d="M13.6 1H2.4A1.4 1.4 0 0 0 1 2.4v11.2A1.4 1.4 0 0 0 2.4 15h11.2a1.4 1.4 0 0 0 1.4-1.4V2.4A1.4 1.4 0 0 0 13.6 1ZM5.2 12.9H3.1V6.4h2.1ZM4.1 5.5a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4Zm8.8 7.4h-2.1V9.7c0-.8 0-1.8-1.1-1.8s-1.3.9-1.3 1.7v3.3H6.3V6.4h2v.9h.1a2.2 2.2 0 0 1 2-1.1c2.1 0 2.5 1.4 2.5 3.2Z"></path>
					</svg>
				</a>
			)}
			{profile?.twitter && (
				<a class="x" href={profile.twitter} rel="noreferrer" target="_blank" aria-label="X (Twitter)">
					<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path d="M9.52 6.77 15.48 0h-1.41L8.9 5.88 4.77 0H0l6.24 8.9L0 16h1.41l5.46-6.21L11.23 16H16L9.52 6.77Zm-1.93 2.2-.63-.89L1.92 1.04h2.17l4.06 5.71.63.89 5.28 7.43h-2.17L7.59 8.97Z"></path>
					</svg>
				</a>
			)}
			<a href={withBase(locale.feedPath)} aria-label={locale.rssLabel}>
				<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
					<circle cx="3.5" cy="12.5" r="1.5"></circle>
					<path d="M2 6.5A7.5 7.5 0 0 1 9.5 14h-2A5.5 5.5 0 0 0 2 8.5Z"></path>
					<path d="M2 2.5A11.5 11.5 0 0 1 13.5 14h-2A9.5 9.5 0 0 0 2 4.5Z"></path>
				</svg>
			</a>
		</div>
		<ThemeToggle lang={lang} />
	</div>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 72px;
	}
	/* Mirrors the brand lockup: monogram + heavy geometric sans, all caps. */
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: hsl(var(--theme-text));
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.wordmark .logo {
		width: 24px;
		height: 19.2px;
		fill: hsl(var(--theme-accent));
		flex-shrink: 0;
		transition: fill 0.2s ease;
	}
	.wordmark:hover {
		color: hsl(var(--theme-accent));
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 22px;
	}
	.socials {
		display: flex;
		align-items: center;
		gap: 14px;
		padding-left: 22px;
		border-left: 1px solid var(--hairline);
	}
	.socials a {
		display: inline-flex;
		color: hsl(var(--theme-text) / 0.62);
		transition: color 0.2s ease;
	}
	.socials a:hover {
		color: hsl(var(--theme-accent));
	}
	.socials a svg {
		width: 16px;
		height: 16px;
	}
	/* The X glyph fills its viewBox edge-to-edge; shrink for optical balance. */
	.socials a.x svg {
		width: 13.5px;
		height: 13.5px;
	}
	.socials a:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}
	.nav {
		display: flex;
		align-items: baseline;
		gap: 22px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.72);
	}
	.nav a {
		display: inline-block;
		position: relative;
		padding-bottom: 3px;
		transition: color 0.2s ease;
	}
	/* Indicator overhangs the text slightly so the underline isn't abrupt. */
	.nav a::after {
		content: "";
		position: absolute;
		left: -3px;
		right: -3px;
		bottom: 0;
		height: 1px;
		background: transparent;
	}
	.nav a:hover {
		color: hsl(var(--theme-accent));
	}
	.nav a.active {
		color: hsl(var(--theme-text));
	}
	.nav a.active::after {
		background: hsl(var(--theme-accent));
	}

	@media (max-width: 720px) {
		.site-header {
			margin-bottom: 36px;
			display: grid;
			grid-template-columns: 1fr auto auto;
			grid-template-areas:
				"wordmark socials theme"
				"nav nav nav";
			align-items: center;
			column-gap: 14px;
			row-gap: 14px;
		}
		.wordmark { grid-area: wordmark; }
		.header-right { display: contents; }
		.socials { grid-area: socials; padding-left: 0; border-left: 0; }
		.theme-toggle { grid-area: theme; justify-self: end; }
		.nav {
			grid-area: nav;
			gap: 22px;
			font-size: 13px;
			flex-wrap: wrap;
			justify-content: flex-start;
		}
		.nav a {
			/* Add top tap padding; desktop rule keeps the indicator space below. */
			padding-top: 6px;
		}
	}

	@media (max-width: 420px) {
		.site-header {
			margin-bottom: 28px;
			row-gap: 12px;
		}
		.wordmark {
			font-size: 12.5px;
			gap: 8px;
		}
		.wordmark .logo {
			width: 20px;
			height: 16px;
		}
		.socials {
			gap: 12px;
		}
		.socials a svg {
			width: 15px;
			height: 15px;
		}
		.socials a.x svg {
			width: 12.5px;
			height: 12.5px;
		}
		.nav {
			gap: 18px;
			font-size: 12.5px;
		}
	}
</style>

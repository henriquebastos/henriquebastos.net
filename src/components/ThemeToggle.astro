---
import { getLocaleConfig } from "@/data/locale";
import { siteConfig } from "@/site-config";
import type { SiteLanguage } from "@/types";

interface Props {
	lang?: SiteLanguage;
}

const { lang = siteConfig.lang } = Astro.props;
const locale = getLocaleConfig(lang);
---

<button class="theme-toggle" id="theme-toggle" type="button" aria-label={locale.toggleThemeLabel}>
	<svg class="icon-sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
		<circle cx="8" cy="8" r="3.25"></circle>
		<path d="M8 1.5v1.5M8 13v1.5M14.5 8H13M3 8H1.5M12.6 3.4l-1.06 1.06M4.46 11.54 3.4 12.6M12.6 12.6l-1.06-1.06M4.46 4.46 3.4 3.4"></path>
	</svg>
	<svg class="icon-moon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
		<path d="M13.54 9.93A6.25 6.25 0 0 1 6.07 2.46a6.25 6.25 0 1 0 7.47 7.47Z"></path>
	</svg>
</button>

<style is:global>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		background: transparent;
		color: hsl(var(--theme-text) / 0.62);
		border: 0;
		cursor: pointer;
		transition: color 0.2s ease;
	}
	.theme-toggle:hover {
		color: hsl(var(--theme-accent));
	}
	.theme-toggle:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
	}

	.theme-toggle svg {
		width: 16px;
		height: 16px;
	}
	/* Show the mode you'd switch to: moon in light, sun in dark. */
	.theme-toggle .icon-sun { display: none; }
	[data-theme="dark"] .theme-toggle .icon-sun { display: block; }
	[data-theme="dark"] .theme-toggle .icon-moon { display: none; }
</style>

<script>
	const r = document.documentElement;
	const btn = document.getElementById("theme-toggle") as HTMLButtonElement | null;
	if (btn) {
		btn.addEventListener("click", () => {
			const next = r.dataset.theme === "dark" ? "light" : "dark";
			r.dataset.theme = next;
			try { localStorage.setItem("theme", next); } catch {}
			document.dispatchEvent(new CustomEvent("theme-change", { detail: { theme: next } }));
		});
	}
</script>

---
import ArticleTimeline from "@/components/blog/ArticleTimeline.astro";
import { getPageAlternates } from "@/data/locale";
import { getPostsByLanguage, sortMDByDate } from "@/data/post";
import { showcase } from "@/data/showcase";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { absoluteUrl } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const allPosts = await getPostsByLanguage(siteConfig.lang);
const allPostsByDate = sortMDByDate(allPosts);
const TIMELINE_LIMIT = 5;
const timelinePosts = allPostsByDate.slice(0, TIMELINE_LIMIT);
const archiveCount = allPosts.length;
const alternates = getPageAlternates("home", Astro.site);

const siteUrl = (path: string) => absoluteUrl(path, Astro.site);
---

<Schema
	item={{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: siteUrl("/"),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: "About",
				item: siteUrl("/about"),
			},
			{
				"@type": "ListItem",
				position: 3,
				name: "Posts",
				item: siteUrl("/writing"),
			},
		],
	}}
/>

<PageLayout alternates={alternates} meta={{ title: "Home", description: siteConfig.description }}>
	<ArticleTimeline posts={timelinePosts} totalCount={archiveCount} variant="home" />

	{
		showcase.length > 0 && (
			<section class="work" aria-labelledby="work-label">
				<div class="section-label" id="work-label">
					Showcase
				</div>
				<ul class="work-list">
					{showcase.map((item) => (
						<li>
							<a href={item.href} rel="noreferrer" target="_blank">
								<div class="head">
									<span class="name">{item.name}</span>
									<span class="stack">{item.stack}</span>
									{item.badge && <span class="badge">{item.badge}</span>}
								</div>
								<p>{item.desc}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>

<style>
	.work {
		margin-bottom: 88px;
	}

	@media (max-width: 420px) {
		.work {
			margin-bottom: 56px;
		}
	}
</style>

---
import ArticleTimeline from "@/components/blog/ArticleTimeline.astro";
import { getPageAlternates } from "@/data/locale";
import { getPostsByLanguage, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const posts = sortMDByDate(await getPostsByLanguage("pt-BR"));
const alternates = getPageAlternates("articles", Astro.site);
const meta = {
	description:
		"Artigos de Henrique Bastos sobre engenharia de software, inteligência artificial e carreira.",
	title: "Artigos em Português",
};
---

<PageLayout alternates={alternates} lang="pt-BR" meta={meta}>
	<ArticleTimeline lang="pt-BR" posts={posts} />
</PageLayout>

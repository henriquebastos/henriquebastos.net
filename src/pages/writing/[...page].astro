---
import ArticleTimeline from "@/components/blog/ArticleTimeline.astro";
import { getPageAlternates } from "@/data/locale";
import type { CollectionEntry } from "astro:content";
import { getPostsByLanguage, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import type { GetStaticPaths, Page } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 1000;
	const allPosts = await getPostsByLanguage(siteConfig.lang);
	const allPostsByDate = sortMDByDate(allPosts);
	return paginate(allPostsByDate, { pageSize: MAX_POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
}

const { page } = Astro.props;

const meta = {
	description: "Read my collection of posts and the things that interest me",
	title: "Posts",
};
const alternates = getPageAlternates("articles", Astro.site);
---

<PageLayout alternates={alternates} meta={meta}>
	<ArticleTimeline
		nextPage={page.url.next}
		posts={page.data}
		previousPage={page.url.prev}
		totalCount={page.total}
	/>
</PageLayout>

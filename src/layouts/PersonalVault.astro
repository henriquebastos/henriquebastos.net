---
import { withBase } from "@/utils/path";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const navigation = [
	{ label: "Overview", path: "/apps/personal-vault/" },
	{ label: "Privacy", path: "/apps/personal-vault/privacy/" },
	{ label: "Terms", path: "/apps/personal-vault/terms/" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} | Personal Vault</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<link rel="icon" type="image/png" href={withBase("/apps/personal-vault/logo-120.png")} />
		<meta name="theme-color" content="#f6f5ef" />
	</head>
	<body data-pagefind-ignore="all">
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="page">
			<header>
				<a class="brand" href={withBase("/apps/personal-vault/")}>
					<img src={withBase("/apps/personal-vault/logo-120.png")} width="60" height="60" alt="" />
					Personal Vault
				</a>
				<p class="byline">A private application by Henrique Bastos</p>
				<nav aria-label="Personal Vault">
					{
						navigation.map(({ label, path }) => (
							<a
								href={withBase(path)}
								aria-current={
									currentPath === withBase(path).replace(/\/$/, "") ? "page" : undefined
								}
							>
								{label}
							</a>
						))
					}
				</nav>
			</header>
			<main id="main" tabindex="-1"><slot /></main>
			<footer>
				<p>Contact: <a href="mailto:henrique@bastos.net">henrique@bastos.net</a></p>
				<p>Last updated: September 16, 2026</p>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		font-family: system-ui, sans-serif;
		color: #20343c;
		background: #f6f5ef;
		line-height: 1.7;
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
	}
	.page {
		max-width: 760px;
		margin: 0 auto;
		padding: 48px 24px;
	}
	header {
		border-bottom: 1px solid #cdd6d0;
		padding-bottom: 24px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 16px;
		font-size: 1.3rem;
		font-weight: 700;
		text-decoration: none;
	}
	.brand img {
		border-radius: 12px;
	}
	.byline,
	footer {
		color: #4c6065;
		font-size: 0.95rem;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
	}
	nav a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}
	nav a[aria-current="page"] {
		font-weight: 700;
		text-decoration-thickness: 2px;
	}
	main {
		padding: 24px 0;
	}
	h1,
	h2 {
		line-height: 1.25;
		letter-spacing: -0.02em;
	}
	h1 {
		font-size: clamp(2rem, 6vw, 2.8rem);
	}
	h2 {
		font-size: 1.35rem;
		margin-top: 2rem;
	}
	p,
	li {
		overflow-wrap: anywhere;
	}
	li + li {
		margin-top: 8px;
	}
	a {
		color: #185c61;
		text-underline-offset: 4px;
	}
	a:hover {
		color: #123e43;
	}
	a:focus-visible {
		outline: 3px solid #185c61;
		outline-offset: 4px;
	}
	footer {
		border-top: 1px solid #cdd6d0;
		padding-top: 20px;
	}
	.skip-link {
		position: absolute;
		top: -100px;
		left: 16px;
		background: #fff;
		padding: 12px;
	}
	.skip-link:focus {
		top: 8px;
	}
</style>

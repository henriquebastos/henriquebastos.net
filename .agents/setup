#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
node_version="$(<"$repo_root/.nvmrc")"
pnpm_version="$(node -p "require('$repo_root/package.json').packageManager.split('@').at(-1)" 2>/dev/null || sed -n 's/.*"packageManager": "pnpm@\([^"]*\)".*/\1/p' "$repo_root/package.json")"
xurl_version="1.3.1"
xurl_checksum="ccfc4b3ca5240565da650ef003b51d7f887eabe0c6e3797802410240289d4feb"

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
	echo "Installing nvm..."
	curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | PROFILE=/dev/null bash
fi

# shellcheck disable=SC1091
source "$NVM_DIR/nvm.sh" --no-use

echo "Installing Node.js $node_version..."
nvm install "$node_version"
nvm alias default "$node_version" >/dev/null
nvm use --silent "$node_version"

if ! command -v pnpm >/dev/null 2>&1 || [[ "$(pnpm --version 2>/dev/null || true)" != "$pnpm_version" ]]; then
	echo "Installing pnpm $pnpm_version..."
	npm install --global "pnpm@$pnpm_version"
fi

if ! command -v xurl >/dev/null 2>&1 || [[ "$(xurl --version 2>/dev/null || true)" != *"$xurl_version"* ]]; then
	echo "Installing xurl $xurl_version..."
	temp_dir="$(mktemp -d)"
	trap 'rm -rf -- "$temp_dir"' EXIT
	archive="$temp_dir/xurl_Linux_x86_64.tar.gz"
	curl -fsSL "https://github.com/xdevplatform/xurl/releases/download/v$xurl_version/xurl_Linux_x86_64.tar.gz" -o "$archive"
	echo "$xurl_checksum  $archive" | sha256sum --check --status
	tar xzf "$archive" -C "$temp_dir"
	install -Dm755 "$temp_dir/xurl" "$HOME/.local/bin/xurl"
	rm -rf -- "$temp_dir"
	trap - EXIT
fi

profile_marker="# henriquebastos.net Node.js environment"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
	cat >>"$HOME/.bash_profile" <<EOF

$profile_marker
export NVM_DIR="\${NVM_DIR:-\$HOME/.nvm}"
if [[ "\${PWD}" == "$repo_root" && -s "\$NVM_DIR/nvm.sh" ]]; then
	. "\$NVM_DIR/nvm.sh" --no-use
	nvm use --silent
fi
EOF
fi

echo "Installing project dependencies..."
pnpm --dir "$repo_root" install --frozen-lockfile
echo "Orb setup complete."
